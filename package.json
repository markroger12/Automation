{
  "name": "blog-automation-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted dashboard that writes SEO blog articles with the ChatGPT website and saves them as WordPress drafts.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "next dev -p 3000",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch --clear-screen=false src/worker/index.ts",
    "dev:all": "concurrently -k -n web,worker -c blue,magenta \"npm:dev\" \"npm:worker:dev\"",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "start:all": "concurrently -k -n web,worker -c blue,magenta \"npm:start\" \"npm:worker\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio",
    "user:create": "tsx scripts/create-user.ts",
    "tools:install": "tsx scripts/install-tools.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "~6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.545.0",
    "marked": "^16.4.2",
    "next": "~15.5.27",
    "papaparse": "^5.7.0",
    "playwright": "~1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "concurrently": "^9.2.5",
    "postcss": "^8.5.29",
    "prisma": "~6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
