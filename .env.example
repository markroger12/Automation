# Copied to .env by `npm run setup` (which also fills SESSION_SECRET with a random value).
DATABASE_URL="file:../data/app.db"
SESSION_SECRET=""
# Browser used for WordPress automation: chrome | msedge | chromium
BROWSER_CHANNEL="chrome"
# Public address of the dashboard (used by the Automation Chrome start page)
APP_URL="http://localhost:3000"
# Optional: Google results for the Plagiarism Check (https://serper.dev)
SERPER_API_KEY=""
# Optional: full path to chrome.exe when Chrome is not in the usual place
CHROME_PATH=""
